#!/usr/bin/env bash

set -euo pipefail

command -v codex >/dev/null 2>&1 || {
    printf '%s\n' 'quickfix: codex is required; install it and run `codex login`' >&2
    exit 1
}

shell=${1:-bash}
[[ $# -le 1 ]] || {
    printf '%s\n' 'usage: ./install [bash|zsh]' >&2
    exit 1
}

root=$(cd -- "$(dirname -- "$0")" && pwd -P)
bin_dir=${HOME}/.local/bin
config_dir=${XDG_CONFIG_HOME:-${HOME}/.config}/quickfix

case $shell in
    bash)
        asset=$config_dir/quickfix.bash
        source_file=$root/quickfix.bash
        shell_rc=${QUICKFIX_RC:-${HOME}/.bashrc}
        restart='exec bash'
        ;;
    zsh)
        asset=$config_dir/quickfix.zsh
        source_file=$root/quickfix.zsh
        shell_rc=${QUICKFIX_RC:-${ZDOTDIR:-${HOME}}/.zshrc}
        restart='exec zsh'
        ;;
    *)
        printf '%s\n' 'usage: ./install [bash|zsh]' >&2
        exit 1
        ;;
esac

mkdir -p -- "$bin_dir" "$config_dir" "$(dirname -- "$shell_rc")"
install -m 755 -- "$root/quickfix" "$bin_dir/quickfix"
install -m 644 -- "$source_file" "$asset"

touch -- "$shell_rc"
temporary=$(mktemp "${shell_rc}.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT

awk '
    /^# quickfix begin$/ { skip = 1; next }
    /^# quickfix end$/ { skip = 0; next }
    /^# cmdsmith integration begin$/ { skip = 1; next }
    /^# cmdsmith integration end$/ { skip = 0; next }
    !skip { lines[++count] = $0 }
    END {
        while (count && lines[count] == "") {
            count--
        }
        for (line = 1; line <= count; line++) {
            print lines[line]
        }
    }
' "$shell_rc" >"$temporary"

{
    printf '\n# quickfix begin\n'
    printf 'source %q\n' "$asset"
    printf '# quickfix end\n'
} >>"$temporary"

chmod --reference="$shell_rc" "$temporary"
mv -- "$temporary" "$shell_rc"
trap - EXIT

printf 'installed quickfix for %s\n  command: %s\n  Alt+O:   %s\n' \
    "$shell" "$bin_dir/quickfix" "$asset"
printf 'restart the shell with: %s\n' "$restart"
